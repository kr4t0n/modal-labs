# Deploy-time configuration, read by app.py when you run `modal deploy` /
# `modal serve` — re-deploy after changing anything here:
#
#   set -a && source .env && set +a && modal deploy app.py
#
# No secrets belong in this file — only the *names* of Modal Secrets. Modal
# credentials live in ~/.modal.toml (`modal setup`), the Hugging Face and
# Civitai tokens live in Modal Secrets, and proxy-auth tokens belong in your
# shell or in comfy_node/.env.
#
# Both tokens are needed by `download_models` alone. The serving containers read
# the weights Volume and need no credentials at all.

# Name of the Modal Secret holding HF_TOKEN. Three of the weight files are
# gated, so the account behind that token must have accepted the FLUX.2 licence:
#   modal secret create huggingface-secret HF_TOKEN=hf_...
FLUX2KLEIN_HF_SECRET=huggingface-secret

# Name of the Modal Secret holding CIVITAI_TOKEN. Four of the LoRA adapters come
# from Civitai, which serves NSFW-flagged files only to an authenticated caller:
#   modal secret create civitai-secret CIVITAI_TOKEN=...
# Civitai -> Account settings -> API Keys. One secret serves every service in
# this repository, so reuse it rather than making per-service copies; this
# variable exists for the case where you keep more than one.
FLUX2KLEIN_CIVITAI_SECRET=civitai-secret

# GPU type. ~44 GB of weights on disk, but only one transformer and one encoder
# load at a time: ~18 GB for base/distilled, ~26 GB for base-uncensored, whose
# encoder is bf16. See README, "Choosing a GPU".
FLUX2KLEIN_GPU=H100

# Keep N containers warm to avoid cold starts. Costs money while idle.
FLUX2KLEIN_MIN_CONTAINERS=0

# The ComfyUI queue, /history and /view are per-container state, so a second
# replica would answer for prompts it never ran. Raise only if every client
# submits and polls within a single request.
FLUX2KLEIN_MAX_CONTAINERS=1

# Seconds a container stays warm after its last request.
FLUX2KLEIN_SCALEDOWN_WINDOW=300

# Requests handled concurrently per container. Sampling is serialised by
# ComfyUI regardless; this keeps progress polls from blocking behind a render.
FLUX2KLEIN_CONCURRENT_INPUTS=20

# Require Modal-Key / Modal-Secret headers on the API endpoint. Leave on.
FLUX2KLEIN_REQUIRE_AUTH=1

# Same for the browser UI. Off by default because browsers cannot attach the
# headers; only run that endpoint via `modal serve` (ephemeral URL).
FLUX2KLEIN_UI_REQUIRE_AUTH=0
