{
  "load_checkpoint": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "waiIllustriousSDXL_v170.safetensors"
    },
    "_meta": {
      "title": "WAI-illustrious-SDXL"
    }
  },
  "clip_skip": {
    "class_type": "CLIPSetLastLayer",
    "inputs": {
      "clip": [
        "load_checkpoint",
        1
      ],
      "stop_at_clip_layer": -2
    },
    "_meta": {
      "title": "CLIP skip"
    }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip_skip",
        0
      ],
      "text": "1girl, solo, silver hair, red eyes, city at night, masterpiece, best quality"
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip_skip",
        0
      ],
      "text": "lowres, bad anatomy, bad hands, text, error, missing fingers, extra digit, fewer digits, cropped, worst quality, low quality, normal quality, jpeg artifacts, signature, watermark, username, blurry"
    },
    "_meta": {
      "title": "Negative prompt"
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 832,
      "height": 1216,
      "batch_size": 1
    },
    "_meta": {
      "title": "Empty latent"
    }
  },
  "sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "load_checkpoint",
        0
      ],
      "seed": 0,
      "steps": 28,
      "cfg": 5.0,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "positive": [
        "positive",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "latent_image": [
        "latent",
        0
      ],
      "denoise": 1.0
    },
    "_meta": {
      "title": "Sample"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "load_checkpoint",
        2
      ]
    },
    "_meta": {
      "title": "Decode"
    }
  },
  "save_image": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "wai-illustrious"
    },
    "_meta": {
      "title": "Save"
    }
  }
}
