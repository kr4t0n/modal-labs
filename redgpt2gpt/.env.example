# Deploy-time configuration, read by app.py when you run `modal deploy` /
# `modal serve` — re-deploy after changing anything here:
#
#   set -a && source .env && set +a && modal deploy app.py
#
# No secrets belong in this file — only the *name* of a Modal Secret.
#
# Name of the Modal Secret holding CIVITAI_TOKEN. The checkpoint is NSFW-flagged
# on Civitai, which serves such files only to an authenticated caller and
# answers 401 otherwise:
#   modal secret create civitai-secret CIVITAI_TOKEN=...
# Civitai -> Account settings -> API Keys. One secret serves every service in
# this repository, so reuse it rather than making per-service copies; this
# variable exists for the case where you keep more than one.
#
# The Hugging Face companions are ungated, and this token is needed by
# `download_models` alone — the serving containers read the weights Volume and
# need no credentials at all.
REDGPT2GPT_CIVITAI_SECRET=civitai-secret

# GPU type. ~18 GB of weights, but the text encoder offloads after encoding so
# the sampling working set is nearer 13 GB. L40S is the safe default; A10 is
# about half the price and very likely fits. See README, "Choosing a GPU".
REDGPT2GPT_GPU=L40S

# Keep N containers warm to avoid cold starts. Costs money while idle.
REDGPT2GPT_MIN_CONTAINERS=0

# The ComfyUI queue, /history and /view are per-container state, so a second
# replica would answer for prompts it never ran.
REDGPT2GPT_MAX_CONTAINERS=1

# Seconds a container stays warm after its last request.
REDGPT2GPT_SCALEDOWN_WINDOW=300

# Requests handled concurrently per container.
REDGPT2GPT_CONCURRENT_INPUTS=20

# Require Modal-Key / Modal-Secret headers on the API endpoint. Leave on.
REDGPT2GPT_REQUIRE_AUTH=1

# Same for the browser UI. Off by default because browsers cannot attach the
# headers; only run that endpoint via `modal serve` (ephemeral URL).
REDGPT2GPT_UI_REQUIRE_AUTH=0
