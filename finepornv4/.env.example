# Deploy-time configuration, read by app.py when you run `modal deploy` /
# `modal serve` — re-deploy after changing anything here:
#
#   set -a && source .env && set +a && modal deploy app.py
#
# This service needs no credentials: the Civitai checkpoint is anonymous and
# digest-verified, and its companions are ungated on Hugging Face.

# GPU type. ~30 GB of weights; the text encoder offloads after encoding, so the
# sampling working set is the 25.7 GB bf16 transformer plus activations — and
# this service renders at 1280x1280 by default, which makes those larger than
# the 1 MP the other services assume. H100 is the safe default; a 48 GB L40S
# fits and is cheaper. See README, "Choosing a GPU".
FINEPORNV4_GPU=H100

# Keep N containers warm to avoid cold starts. Costs money while idle. Worth
# more here than elsewhere: 25.7 GB takes a while to reach the GPU.
FINEPORNV4_MIN_CONTAINERS=0

# The ComfyUI queue, /history and /view are per-container state, so a second
# replica would answer for prompts it never ran.
FINEPORNV4_MAX_CONTAINERS=1

# Seconds a container stays warm after its last request.
FINEPORNV4_SCALEDOWN_WINDOW=300

# Requests handled concurrently per container.
FINEPORNV4_CONCURRENT_INPUTS=20

# Require Modal-Key / Modal-Secret headers on the API endpoint. Leave on.
FINEPORNV4_REQUIRE_AUTH=1

# Same for the browser UI. Off by default because browsers cannot attach the
# headers; only run that endpoint via `modal serve` (ephemeral URL).
FINEPORNV4_UI_REQUIRE_AUTH=0
