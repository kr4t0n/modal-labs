# Deploy-time configuration. These are read by app.py when you run
# `modal deploy` / `modal serve`, not by the running container, so re-deploy
# after changing them:
#
#   set -a && source .env && set +a && modal deploy app.py
#
# This file holds no secrets. Modal credentials live in ~/.modal.toml
# (`modal setup`), and proxy-auth tokens belong in your shell or in
# comfy_node/.env — never here, and never in git.

# GPU type. 29.5 GB of weights, ~18.9 GB resident during sampling. L40S (48 GB)
# fits everything at roughly half H100's hourly rate but is slower; A100 and A10
# lack fp8 tensor cores. See README, "Choosing a GPU".
IDEOGRAM4_GPU=H100

# Keep N containers warm to avoid cold starts. Costs money while idle.
IDEOGRAM4_MIN_CONTAINERS=0

# The ComfyUI queue, /history and /view are per-container state, so a second
# replica would answer for prompts it never ran. Raise only if every client
# submits and polls within a single request.
IDEOGRAM4_MAX_CONTAINERS=1

# Seconds a container stays warm after its last request.
IDEOGRAM4_SCALEDOWN_WINDOW=300

# Requests handled concurrently per container. Sampling is serialised by
# ComfyUI regardless; this keeps progress polls from blocking behind a render.
IDEOGRAM4_CONCURRENT_INPUTS=20

# Require Modal-Key / Modal-Secret headers on the API endpoint. Leave on.
IDEOGRAM4_REQUIRE_AUTH=1

# Same for the browser UI. Off by default because browsers cannot attach the
# headers; only run that endpoint via `modal serve` (ephemeral URL).
IDEOGRAM4_UI_REQUIRE_AUTH=0
