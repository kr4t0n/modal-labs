# Deploy-time configuration, read by app.py when you run `modal deploy` /
# `modal serve` — re-deploy after changing anything here:
#
#   set -a && source .env && set +a && modal deploy app.py
#
# This service needs no credentials: the Civitai checkpoint is anonymous and
# digest-verified, and its companions are ungated on Hugging Face.
#
# It is the exception. The other Civitai-sourced services here (flux2klein,
# finepornv4, redgpt2gpt) fetch NSFW-flagged files, which Civitai serves only to
# an authenticated caller, so those need a CIVITAI_TOKEN Secret. This one does
# not — do not add it on the assumption that the family should match.

# GPU type. ~19 GB of weights, but the text encoder offloads after encoding so
# the sampling working set is nearer 14 GB. L40S is the safe default; A10 is
# about half the price and very likely fits. See README, "Choosing a GPU".
ULTRA_GPU=L40S

# Keep N containers warm to avoid cold starts. Costs money while idle.
ULTRA_MIN_CONTAINERS=0

# The ComfyUI queue, /history and /view are per-container state, so a second
# replica would answer for prompts it never ran.
ULTRA_MAX_CONTAINERS=1

# Seconds a container stays warm after its last request.
ULTRA_SCALEDOWN_WINDOW=300

# Requests handled concurrently per container.
ULTRA_CONCURRENT_INPUTS=20

# Require Modal-Key / Modal-Secret headers on the API endpoint. Leave on.
ULTRA_REQUIRE_AUTH=1

# Same for the browser UI. Off by default because browsers cannot attach the
# headers; only run that endpoint via `modal serve` (ephemeral URL).
ULTRA_UI_REQUIRE_AUTH=0
