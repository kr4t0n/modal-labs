{
  "load_unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ultra_v15.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "ULTRA (Krea 2)"
    }
  },
  "load_clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_4b_fp8_scaled.safetensors",
      "type": "krea2",
      "device": "default"
    },
    "_meta": {
      "title": "Qwen3-VL 4B text encoder"
    }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "load_clip",
        0
      ],
      "text": "a low angle action shot of a cyclist on a rain-slick street at dusk"
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "negative": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "positive",
        0
      ]
    },
    "_meta": {
      "title": "Zeroed conditioning"
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "_meta": {
      "title": "Empty latent"
    }
  },
  "sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "load_unet",
        0
      ],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "positive",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "latent_image": [
        "latent",
        0
      ],
      "denoise": 1.0
    },
    "_meta": {
      "title": "Sample"
    }
  },
  "load_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    },
    "_meta": {
      "title": "VAE"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "load_vae",
        0
      ]
    },
    "_meta": {
      "title": "Decode"
    }
  },
  "save_image": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "ultra"
    },
    "_meta": {
      "title": "Save"
    }
  }
}
