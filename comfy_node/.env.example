# Copy to `.env` in this directory, or export these in the shell that starts
# ComfyUI. Never commit the filled-in file.
#
# One package serves every Modal deployment, so set only the URLs you use — a
# node whose URL is unset raises a clear error rather than failing obscurely.

FLUX2KLEIN_MODAL_URL=https://your-workspace--flux2klein-comfyui-flux2klein-web.modal.run
ULTRA_MODAL_URL=https://your-workspace--ultra-comfyui-ultra-web.modal.run
ZIMAGETURBOSTABLEYOGI_MODAL_URL=https://your-workspace--zimageturbostableyogi-comfyui-zimageturbostableyogi-web.modal.run
FINEPORNV4_MODAL_URL=https://your-workspace--finepornv4-comfyui-finepornv4-web.modal.run

# Modal proxy auth token (Dashboard -> Settings -> Proxy Auth Tokens), shared by
# every endpoint. Omit both if you deployed with *_REQUIRE_AUTH=0.
MODAL_KEY=wk-xxxxxxxxxxxxxxxxxxxxxx
MODAL_SECRET=ws-xxxxxxxxxxxxxxxxxxxxxx
